# Copy this file to .env and fill in the values from your Firebase project.
#
# Where to find them: Firebase Console -> Project settings (gear icon) ->
# General tab -> scroll to "Your apps" -> click the web app (</>) ->
# "SDK setup and configuration" -> "Config".
#
# If you haven't created a web app in your Firebase project yet, click
# "Add app" -> the web (</>) icon, and it'll generate all of these for you.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
