rules_version = '2';

// Klotho Connect — Firestore security rules
//
// The chapter-lead signup code lives ONLY in this file (see
// adminVerifications below). It is never sent to the client bundle and
// never stored anywhere a client can read back — only its *existence*
// (via a short-lived verification doc) is ever checked.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOfChapter(chapterId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'admin'
        && myProfile().chapterId == chapterId;
    }

    function passedAdminCodeCheck() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminVerifications/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminVerifications/$(request.auth.uid)).data.verifiedAt
             > request.time - duration.value(1, 'h');
    }

    match /adminVerifications/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.code == "5N5vT{{sU<sj1Q>@W6ef`[Hh0";
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId && (
        (
          request.resource.data.role == 'volunteer' &&
          request.resource.data.keys().hasAll(['name', 'email', 'role'])
        ) || (
          request.resource.data.role == 'admin' &&
          request.resource.data.chapterId is string &&
          passedAdminCodeCheck()
        )
      );

      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'favoriteChapterIds']);

      allow delete: if false;

      match /myEvents/{eventId} {
        allow read, create: if isSignedIn() && request.auth.uid == userId;

        allow update: if isSignedIn()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId);

        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            exists(/databases/$(database)/documents/events/$(eventId)) &&
            isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
          )
        );
      }
    }

    match /chapters/{chapterId} {
      allow read: if true;

      allow create: if passedAdminCodeCheck()
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.state is string;

      allow update: if passedAdminCodeCheck()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds'])
        && request.resource.data.adminIds == resource.data.adminIds.concat([request.auth.uid]);

      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if isAdminOfChapter(request.resource.data.chapterId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.signupCount == 0
        && request.resource.data.quotaFinalized == false;

      // Quota fields (quotaFinalized/quotaMet/finalSignupCount) are
      // deliberately excluded from what a chapter admin's *general* edit
      // can touch (branch 1 below) -- they're only ever set by the
      // narrow "finalize" branch 3, which locks them in exactly once and
      // verifies the values itself rather than trusting the client. This
      // app runs on Firebase's free Spark plan (no Cloud Functions), so
      // there's no server-side scheduled job -- finalizeChapterQuotas()
      // in lib/firestore.js runs this from a chapter admin's own browser
      // whenever they view their events, and these rules are what make
      // that safe to trust despite coming from a client.
      allow update: if (
        // 1. Regular admin edit of event details -- quota fields must
        // stay exactly as they were.
        isAdminOfChapter(resource.data.chapterId)
        && request.resource.data.chapterId == resource.data.chapterId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.quotaFinalized == resource.data.quotaFinalized
        && request.resource.data.quotaMet == resource.data.quotaMet
        && request.resource.data.finalSignupCount == resource.data.finalSignupCount
      ) || (
        // 2. A volunteer's own sign-up/cancel nudging the counter by
        // exactly one, and touching nothing else.
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupCount'])
        && (
          request.resource.data.signupCount == resource.data.signupCount + 1 ||
          request.resource.data.signupCount == resource.data.signupCount - 1
        )
      ) || (
        // 3. Quota finalization -- any admin of this chapter can lock in
        // the verdict for a past, not-yet-finalized event, but only with
        // values these rules verify are actually correct: the event must
        // genuinely have ended, finalSignupCount must equal the real
        // current signupCount (not an arbitrary number), quotaMet must
        // be the real comparison against the real goal, nothing else on
        // the document may change, and quotaFinalized can only move
        // false -> true -- once set, this branch can never fire again
        // for this document, so it can't be replayed to change the
        // verdict later.
        isAdminOfChapter(resource.data.chapterId)
        && resource.data.quotaFinalized == false
        && resource.data.endDateTime <= request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quotaFinalized', 'quotaMet', 'finalSignupCount'])
        && request.resource.data.quotaFinalized == true
        && request.resource.data.finalSignupCount == resource.data.signupCount
        && request.resource.data.quotaMet == (resource.data.signupCount >= resource.data.volunteersNeeded)
      );

      allow delete: if isAdminOfChapter(resource.data.chapterId);

      match /signups/{uid} {
        allow get: if isSignedIn() && (
          request.auth.uid == uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow list: if isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.eventId == eventId;

        allow delete: if isSignedIn() && (
          request.auth.uid == uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow update: if false;
      }
    }
  }
}