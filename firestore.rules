rules_version = '2';

// Klotho Connect — Firestore security rules
//
// The chapter-lead signup code lives ONLY in this file (see
// adminVerifications below). It is never sent to the client bundle and
// never stored anywhere a client can read back — only its *existence*
// (via a short-lived verification doc) is ever checked.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOfChapter(chapterId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().role == 'admin'
        && myProfile().chapterId == chapterId;
    }

    function passedAdminCodeCheck() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/adminVerifications/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminVerifications/$(request.auth.uid)).data.verifiedAt
             > request.time - duration.value(1, 'h');
    }

    match /adminVerifications/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.code == "5N5vT{{sU<sj1Q>@W6ef`[Hh0";
      allow delete: if isSignedIn() && request.auth.uid == uid;
      allow read, update: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId && (
        (
          request.resource.data.role == 'volunteer' &&
          request.resource.data.keys().hasAll(['name', 'email', 'role'])
        ) || (
          request.resource.data.role == 'admin' &&
          request.resource.data.chapterId is string &&
          passedAdminCodeCheck()
        )
      );

      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'favoriteChapterIds']);

      allow delete: if false;

      // myEvents/{eventId} -- a denormalized copy of an event the owner
      // has signed up for, written in the same batch as the signup
      // itself (see signUpForEvent/cancelSignup/deleteEvent in
      // lib/firestore.js). This is what makes "My events" a single cheap
      // read instead of a fragile cross-chapter collection-group query.
      // The owner creates/deletes their own copies; the event's chapter
      // admin can refresh (not create/delete) copies when they edit the
      // event, so an edit never leaves a volunteer looking at stale info.
      match /myEvents/{eventId} {
        allow read, create: if isSignedIn() && request.auth.uid == userId;

        allow update: if isSignedIn()
          && exists(/databases/$(database)/documents/events/$(eventId))
          && isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId);

        allow delete: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            exists(/databases/$(database)/documents/events/$(eventId)) &&
            isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
          )
        );
      }
    }

    match /chapters/{chapterId} {
      allow read: if true;

      allow create: if passedAdminCodeCheck()
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.state is string;

      allow update: if passedAdminCodeCheck()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminIds'])
        && request.resource.data.adminIds == resource.data.adminIds.concat([request.auth.uid]);

      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;

      allow create: if isAdminOfChapter(request.resource.data.chapterId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.reminderSent == false
        && request.resource.data.signupCount == 0;

      allow update: if (
        isAdminOfChapter(resource.data.chapterId)
        && request.resource.data.chapterId == resource.data.chapterId
        && request.resource.data.createdBy == resource.data.createdBy
      ) || (
        isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signupCount'])
        && (
          request.resource.data.signupCount == resource.data.signupCount + 1 ||
          request.resource.data.signupCount == resource.data.signupCount - 1
        )
      );

      allow delete: if isAdminOfChapter(resource.data.chapterId);

      // signups/{uid} — one doc per volunteer, doc id == their own uid.
      // get/delete use the path segment; list uses the data field
      // (needed for the admin roster query — see isAdminOfChapter below).
      match /signups/{uid} {
        allow get: if isSignedIn() && (
          request.auth.uid == uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow list: if isSignedIn() && (
          resource.data.uid == request.auth.uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.eventId == eventId;

        allow delete: if isSignedIn() && (
          request.auth.uid == uid ||
          isAdminOfChapter(get(/databases/$(database)/documents/events/$(eventId)).data.chapterId)
        );

        allow update: if false;
      }
    }
  }
}